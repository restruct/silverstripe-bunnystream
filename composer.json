{
    "name": "restruct/silverstripe-bunnystream",
    "description": "Bunny Stream video integration for Silverstripe: upload, manage and embed videos",
    "type": "silverstripe-vendormodule",
    "homepage": "https://github.com/restruct/silverstripe-bunnystream",
    "keywords": [
        "silverstripe",
        "video",
        "bunny",
        "bunnycdn",
        "streaming"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Restruct",
            "email": "dev@restruct.nl",
            "homepage": "https://restruct.nl"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5 || ^6",
        "silverstripe/admin": "^2 || ^3",
        "silverstripe/assets": "^2 || ^3",
        "silverstripe/vendor-plugin": "^2 || ^3",
        "guzzlehttp/guzzle": "^7.3"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3 || ^4"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\BunnyStream\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\BunnyStream\\Tests\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ],
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ]
}
